rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /competitions/{competitionId} {
      allow read, write: if true;
    }

    match /appData/{docId} {
      allow read, write: if true;
    }

    match /appConfig/{configId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
